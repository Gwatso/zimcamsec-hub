# ---------------------------------------------------------------------------
# Zimcamsec Hub configuration. Copy to `.env.local` for development.
# Every variable is optional in development; see docs/ARCHITECTURE.md §9.
# ---------------------------------------------------------------------------

# Public base URL (used in emails, sitemap and absolute links).
APP_URL=http://localhost:3000

# PostgreSQL connection string. Leave empty to use the embedded PGlite
# database stored in PGLITE_DIR (single process only — dev / small installs).
DATABASE_URL=
DATABASE_POOL_MAX=10
PGLITE_DIR=./.data/pglite

# Apply pending SQL migrations on server start (safe with multiple instances:
# guarded by a Postgres advisory lock).
AUTO_MIGRATE=true

# Where uploaded PDFs, previews and covers are stored.
STORAGE_DIR=./storage

# Support desk routing.
SUPPORT_INBOX=edu.novacacia@gmail.com
MAIL_FROM="Zimcamsec Hub <no-reply@zimcamsec.co.zw>"
# Resend (https://resend.com) API key. Without it, tickets are stored and
# shown in the admin support queue but no email is sent.
RESEND_API_KEY=

# Bootstrap Master Admin account (created on seed if it does not exist).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Populate demo resources on an empty database. Never enable in production.
SEED_DEMO_CONTENT=

# Set to true when running behind a reverse proxy / load balancer that sets
# X-Forwarded-For (needed for per-IP rate limiting).
TRUST_PROXY=false
